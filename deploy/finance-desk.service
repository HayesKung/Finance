# Finance · MM-FINPIVOT 内部作战台 systemd 单元
#
# 前置：已在 /opt/finance-finpivot 完成 `npm install && npm run build`。
# 说明：必须走 listen.mjs，它固定回环地址并用 /proc/net/tcp 复核监听范围。
#       直接用 .output/server/index.mjs 会绕过这层核对，见 docs/03-本地构建.md。
#
# 鉴权状态：AuthProvider 是透传，不是访问控制。本单元只绑 127.0.0.1，
#           不暴露公网。真实鉴权落地之前不要改 PORT_HOST，也不要加 nginx vhost。
#
# 安装：
#   useradd -r -s /usr/sbin/nologin -d /opt/finance-finpivot finance
#   cp deploy/finance-desk.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now finance-desk
#
# 数据库（合同 / 签名 / 支付通道密钥持久化，src/lib/db.ts 使用）：
#   先建库与账号，并执行 migrations/0002_fin_contract.sql，例如：
#     create role finpivot login password '<随机口令>';
#     create database finpivot owner finpivot;
#     psql -h 127.0.0.1 -p <端口> -U finpivot -d finpivot -f migrations/0002_fin_contract.sql
#   再把连接串写入仅 root 可读的文件（不要把凭据提交进仓库）：
#     printf 'DATABASE_URL=postgresql://finpivot:<口令>@127.0.0.1:<端口>/finpivot\n' \
#       > /etc/finance-desk.env && chmod 600 /etc/finance-desk.env
#   未设置 DATABASE_URL 时，合同读写会在调用时抛错（懒初始化，不影响启动）。

[Unit]
Description=Finance MM-FINPIVOT desk (TanStack Start SSR, loopback only)
After=network.target

[Service]
Type=simple
User=finance
Group=finance
WorkingDirectory=/opt/finance-finpivot
Environment=NODE_ENV=production
Environment=PORT=4173
EnvironmentFile=/etc/finance-desk.env
ExecStart=/usr/bin/node /opt/finance-finpivot/listen.mjs
Restart=always
RestartSec=5

# 收紧运行边界
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
CapabilityBoundingSet=
MemoryMax=768M

StandardOutput=journal
StandardError=journal
SyslogIdentifier=finance-desk

[Install]
WantedBy=multi-user.target
